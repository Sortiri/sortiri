{
  "name": "sortiri-timeline",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sortiri/sortiri.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "bash scripts/dev-e2e.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "playwright test",
    "test:e2e": "playwright test",
    "test:ui:setup": "tsx scripts/setup-e2e-auth.ts",
    "test:ui:headed": "playwright test --headed",
    "test:all": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.packages.json",
    "mcp:dev": "tsx packages/mcp/src/server.ts",
    "convex:dev": "convex dev",
    "convex:dev:once": "convex dev --once",
    "convex:deploy": "convex deploy --yes",
    "convex:deploy:preview": "convex deploy --yes",
    "smoke:enrich": "tsx scripts/enrich-mcp-smoke-test.ts",
    "sortiri:init": "tsx packages/cli/src/index.ts init",
    "sortiri:dev": "tsx packages/cli/src/index.ts dev",
    "sdk:example": "tsx packages/sdk/examples/basic.ts",
    "test:github-webhook": "vitest run tests/api/github-webhook-signature.test.ts",
    "test:stripe-webhook": "tsx scripts/test-stripe-webhook.ts",
    "test:posthog-webhook": "tsx scripts/test-posthog-webhook.ts",
    "sanity:posthog-integration": "tsx scripts/sanity-posthog-integration.ts",
    "sanity:impact-analysis": "tsx scripts/sanity-impact-analysis.ts",
    "sanity:lessons-playbooks": "tsx scripts/sanity-lessons-playbooks.ts",
    "sanity:agent-context-loop": "tsx scripts/sanity-agent-context-loop.ts",
    "sanity:autonomy-queue": "tsx scripts/sanity-autonomy-queue.ts",
    "sanity:cli-recommendations": "tsx scripts/sanity-cli-recommendations.ts",
    "sanity:mcp-recommendation-tools": "tsx scripts/sanity-mcp-recommendation-tools.ts",
    "sanity:private-evals": "tsx scripts/sanity-private-evals.ts",
    "sanity:eval-remediation-loop": "tsx scripts/sanity-eval-remediation-loop.ts",
    "sanity:enterprise-reliability": "tsx scripts/sanity-enterprise-reliability.ts",
    "sanity:slack-decision-memory": "tsx scripts/sanity-slack-decision-memory.ts",
    "sanity:observability-incident-memory": "tsx scripts/sanity-observability-incident-memory.ts",
