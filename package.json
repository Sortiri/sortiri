    "sanity:platform-pages-ui": "tsx scripts/sanity-platform-pages-ui.ts",
    "sanity:convex-api-surface": "tsx scripts/sanity-convex-api-surface.ts",
    "sanity:open-source-project": "tsx scripts/sanity-open-source-project.ts",
    "sanity:github-open-source-infra": "tsx scripts/sanity-github-open-source-infra.ts",
    "sanity:open-source-star-readiness": "tsx scripts/sanity-open-source-star-readiness.ts",
    "demo:oss": "tsx scripts/demo-open-source-local.ts",
    "scan:oss-trust": "tsx scripts/scan-oss-trust.ts",
    "generate:oss-assets": "tsx scripts/generate-oss-launch-assets.ts",
    "assert:no-next-backend-routes": "tsx scripts/assert-no-next-backend-routes.ts",
    "assert:no-landing-changes": "tsx scripts/assert-no-landing-changes.ts",
    "audit:next-api-routes": "tsx scripts/audit-next-api-routes.ts",
    "sanity:cli-evals": "tsx scripts/sanity-cli-evals.ts",
    "sanity:mcp-eval-tools": "tsx scripts/sanity-mcp-eval-tools.ts",
    "eval:run": "tsx scripts/run-eval-suite.ts",
    "sanity:cli-context": "tsx scripts/sanity-cli-context.ts",
    "sanity:mcp-context-tools": "tsx scripts/sanity-mcp-context-tools.ts",
    "sanity:intelligence-hub": "tsx scripts/sanity-intelligence-hub.ts",
    "migrate:github-secrets": "tsx scripts/migrate-github-secrets.ts",
    "sanity:integration-secrets": "tsx scripts/sanity-integration-secrets.ts",
    "test:cli-setup": "tsx scripts/test-cli-setup.ts",
    "test:cli-run": "tsx scripts/test-cli-run.ts",
    "test:event-display": "vitest run tests/unit/event-display.test.ts",
    "test:entity-extraction": "vitest run tests/unit/entity-extraction.test.ts",
    "test:project-scoping": "vitest run tests/unit/project-scoping.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@clerk/nextjs": "^7.5.2",
    "@convex-dev/agent": "^0.6.3",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sortiri/sdk": "*",
    "@sortiri/security": "*",
    "ai": "^6.0.204",
    "convex": "^1.41.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "pixelarticons": "^2.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@clerk/testing": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
