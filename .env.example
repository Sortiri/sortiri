# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Frontend API URL (Issuer) — enable Convex integration in Clerk dashboard
CLERK_JWT_ISSUER_DOMAIN=

# Convex — populated by `npm run convex:dev:once`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Vercel / CI only — do not commit real keys
# Production: npx convex deployment token create vercel-production --prod
# Preview: Convex dashboard → Project Settings → Preview Deploy Keys
CONVEX_DEPLOY_KEY=

# MCP ingest (Next.js + Convex — dev-only fallback; prefer workspace API keys)
SORTIRI_DEV_INGEST_KEY=dev_sortiri_key

# Sortiri SDK / CLI / MCP (create keys on the Sources page)
SORTIRI_API_URL=http://127.0.0.1:3210
SORTIRI_API_KEY=sk_sortiri_...
# Optional when using workspace API keys (resolved from SORTIRI_API_KEY):
SORTIRI_WORKSPACE_ID=
SORTIRI_PROJECT_ID=

# Convex Agent — Crusoe inference (set on Convex deployment)
# npx convex env set CRUSOE_API_KEY <key>
CRUSOE_API_KEY=

# Server-to-Convex integration calls (GitHub webhooks)
# Set the same value in Convex: npx convex env set SORTIRI_INTEGRATION_SERVER_KEY <key>
SORTIRI_INTEGRATION_SERVER_KEY=
